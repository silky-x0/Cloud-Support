# ── API Keys ─────────────────────────────────────────────────────────────────
# Required: OpenRouter key for LLM + embeddings (free models used by default)
OPEN_ROUTER_KEY=your_openrouter_key_here

# Optional: Direct OpenAI key (used if OPEN_ROUTER_KEY is not set)
OPENAI_API_KEY=

# ── Model Configuration ──────────────────────────────────────────────────────
OPENAI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# ── Database & Storage ───────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
